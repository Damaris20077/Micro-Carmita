PORT=3000
NODE_ENV=development
APP_ORIGIN=http://127.0.0.1:3000
ALLOW_DEV_SUPERUSER=false
# Valores de desarrollo. Complete usuario, contraseña y una base existente en .env.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# Copiar únicamente esta sección a .env.backup (ignorado). El worker no lee .env.
# Respaldos desactivados hasta configurar y autorizar. Directorio privado fuera del proyecto.
BACKUP_ENABLED=false
BACKUP_DIR=
BACKUP_PRIVATE_DIR_CONFIRMED=false
MYSQLDUMP_PATH=
BACKUP_DB_HOST=127.0.0.1
BACKUP_DB_PORT=3306
BACKUP_DB_USER=
BACKUP_DB_PASSWORD=
BACKUP_DB_NAME=micro_carmita
BACKUP_TIMEOUT_SECONDS=600
# Clave base64 de 32 bytes, generada y conservada fuera de Git y del bucket.
BACKUP_ENCRYPTION_KEY=
BACKUP_KEY_ID=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_BACKUP_PREFIX=micro-carmita
R2_PRIVATE_BUCKET_CONFIRMED=false
