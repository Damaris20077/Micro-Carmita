{
  "name": "micro-carmita",
  "version": "1.0.0",
  "description": "Sistema de gestión de Micro Carmita con interfaz HTML, CSS y JavaScript, API Node.js/Express y persistencia MySQL.",
  "main": "app.js",
  "scripts": {
    "test": "node --test modelo.test.cjs app.test.cjs backend/*.test.cjs",
    "db:check": "node backend/check-db.js",
    "auth:bootstrap": "node backend/bootstrap.js",
    "start": "node backend/server.js",
    "backup:status": "node backend/backup-cli.js status",
    "backup:run": "node backend/backup-cli.js run",
    "backup:worker": "node backend/backup-cli.js worker",
    "backup:unlock": "node backend/backup-cli.js unlock",
    "backup:decrypt": "node backend/backup-cli.js decrypt"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Damaris20077/Micro-Carmita.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Damaris20077/Micro-Carmita/issues"
  },
  "homepage": "https://github.com/Damaris20077/Micro-Carmita#readme",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1171.0",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "mysql2": "^3.24.5",
    "pdfkit": "^0.20.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
